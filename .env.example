# Copy to .env.local and fill in. .env* is gitignored and Claude cannot read it.
# The app runs fully WITHOUT any of these (mock mode). Set the key to go live.

# --- Qloo (the one thing that makes it live) ---
# Your hackathon API key. Get it from the Qloo hackathon dashboard.
QLOO_API_KEY=

# Optional. Defaults to the hackathon host. Set to https://api.qloo.com for production.
QLOO_API_URL=

# Optional. Set to 1 to force mock data even when a key is present (useful for demos).
QLOO_USE_MOCK=
